  <>
    <h3 className="apf-step-heading">Bank & images</h3>
    <Field label="Bank / auction property">
      <IonSelect
        className="apf-select"
        value={form.isBankProperty}
        onIonChange={(e) => {
          const value = e.detail.value;
          updateField('isBankProperty', value);
          if (value === 'no') {
            updateField('bankPropertyType', '');
            updateField('customBankType', '');
          }
        }}
      >
        <IonSelectOption value="no">No</IonSelectOption>
        <IonSelectOption value="yes">Yes</IonSelectOption>
      </IonSelect>
    </Field>
    {form.isBankProperty === 'yes' && (
      <>
        <Field label="Bank property type">
          <IonSelect
            className="apf-select"
            placeholder="Select"
            value={form.bankPropertyType}
            onIonChange={(e) => updateField('bankPropertyType', e.detail.value)}
          >
            <IonSelectOption value="Bank Auction Property">Bank Auction Property</IonSelectOption>
            <IonSelectOption value="Distressed Property">Distressed Property</IonSelectOption>
          </IonSelect>
        </Field>
        <Field label="Custom bank type">
          <IonInput
            className="apf-input"
            placeholder="Enter bank name or type"
            value={form.customBankType}
            onIonInput={(e) => updateField('customBankType', e.detail.value!)}
          />
        </Field>
      </>
    )}
    <div className="apf-divider" />
    <p className="apf-upload-hint">
      Add photos to attract more buyers. JPG or PNG, max 10 MB each.
    </p>
    <label className="apf-upload-zone">
      <IonIcon icon={cloudUploadOutline} className="apf-upload-icon" />
      <span className="apf-upload-text">Tap to upload images</span>
      <span className="apf-upload-sub">or drag and drop here</span>
      <input type="file" accept="image/jpeg,image/png" multiple hidden onChange={onImageUpload} />
    </label>
    {imagePreviews.length > 0 && (
      <div className="apf-preview-grid">
        {imagePreviews.map((src, i) => (
          <div className="apf-preview-item" key={i}>
            <img src={src} alt={`Upload ${i + 1}`} />
            <button className="apf-preview-remove" onClick={() => onRemoveImage(i)} aria-label="Remove image">
              <IonIcon icon={closeCircle} />
            </button>
          </div>
        ))}
      </div>
    )}
  </>
);

export default AddPropertyForm;