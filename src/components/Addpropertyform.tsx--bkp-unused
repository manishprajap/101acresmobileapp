      <Field label="Property location" required>
        <IonSelect
          className="apf-select"
          placeholder="Select location type"
          value={form.propertyLocation}
          onIonChange={(e) => updateField('propertyLocation', e.detail.value)}
        >
          <IonSelectOption value="National">National</IonSelectOption>
          <IonSelectOption value="International">International</IonSelectOption>
        </IonSelect>
      </Field>
      <Field label="Listing title" required>
        <IonInput
          className="apf-input"
          placeholder="e.g. 3 BHK Flat in Gomti Nagar"
          value={form.title}
          onIonInput={(e) => updateField('title', e.detail.value!)}
        />
      </Field>
      <div className="apf-row">
        <Field label="Listed for" required>
          <IonSelect
            className="apf-select"
            placeholder="Sale / Rent"
            value={form.propertyFor}
            onIonChange={(e) => updateField('propertyFor', e.detail.value)}
          >
            <IonSelectOption value="Rent">Rent</IonSelectOption>
            <IonSelectOption value="Sale">Sale</IonSelectOption>
          </IonSelect>
        </Field>
        <Field label="Property type">
          <IonSelect
            className="apf-select"
            placeholder="Type"
            value={form.propertyType}
            onIonChange={(e) => {
              updateField('propertyType', e.detail.value);
              updateField('residentialType', '');
            }}
          >
            <IonSelectOption value="Residential">Residential</IonSelectOption>
            <IonSelectOption value="Commercial">Commercial</IonSelectOption>
          </IonSelect>
        </Field>
      </div>
      {subtypes.length > 0 && (
        <Field label={form.propertyType === 'Residential' ? 'Residential type' : 'Commercial type'}>
          <IonSelect
            className="apf-select"
            placeholder="Select sub-type"
            value={form.residentialType}
            onIonChange={(e) => updateField('residentialType', e.detail.value)}
          >
            {subtypes.map((opt) => (
              <IonSelectOption key={opt.value} value={opt.value}>
                {opt.label}
              </IonSelectOption>
            ))}
          </IonSelect>
        </Field>
      )}
      <Field label="Description">
        <IonTextarea
          className="apf-textarea"
          placeholder="Describe the property — key highlights, nearby amenities, condition…"
          autoGrow
          rows={4}
          value={form.description}
          onIonInput={(e) => updateField('description', e.detail.value!)}
        />
      </Field>
    </>
  );
};

