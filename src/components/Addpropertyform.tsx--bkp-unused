import { cloudUploadOutline, closeCircle, checkmarkCircle } from 'ionicons/icons';
import './AddPropertyForm.css';
import { apiGet, apiPost,apiPostFormData } from '../api';


type FormStep = 'owner' | 'basic' | 'size' | 'location' | 'bank';
const STEP_ORDER: FormStep[] = ['owner', 'basic', 'size', 'location', 'bank'];
const STEP_LABELS: Record<FormStep, string> = {
  owner: 'Owner',
  basic: 'Basic',
  size: 'Size & Price',
  location: 'Location',
  bank: 'Images',
};

type LookupItem = { id: number; name: string };

