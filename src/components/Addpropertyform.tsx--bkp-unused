  contactNumber: string;
  contactEmail: string;
  propertyLocation: string;
  title: string;
  propertyFor: string;
  propertyType: string;
  residentialType: string;
  description: string;
  squareFt: string;
  beds: string;
  baths: string;
  price: string;
  priceFor: string;
  country: string;
  countryId: string;
  state: string;
  stateId: string;
  city: string;
  cityId: string;
  area: string;
  areaId: string;
  landmark: string;
  address: string;
  googleLocation: string;
  slug: string;
  isBankProperty: string;
  bankPropertyType: string;
  customBankType: string;
}

const initialFormState: FormState = {
  contactName: '',
  contactNumber: '',
  contactEmail: '',
  propertyLocation: '',
  title: '',
  propertyFor: '',
  propertyType: '',
  residentialType: '',
  description: '',
  squareFt: '',
  beds: '',
  baths: '',
  price: '',
  priceFor: '',
  country: '',
  countryId: '',
  state: '',
  stateId: '',
  city: '',
  cityId: '',
  area: '',
  areaId: '',
  landmark: '',
  address: '',
  googleLocation: '',
  slug: '',
  isBankProperty: 'no',
  bankPropertyType: '',
  customBankType: '',
};

interface AddPropertyFormProps {
  userId: string;
  onSuccess?: () => void;
}

const capitalizeWords = (str: string) =>
  str
    .toLowerCase()
    .trim()
    .split(/\s+/)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const generateSlug = (text: string) =>
  text
    .toLowerCase()
    .trim()
    .replace(/\s+/g, '-')
    .replace(/[^\w-]+/g, '')
    .replace(/--+/g, '-');

const SKIP_CAPITALIZE = new Set([
  'googleLocation',
  'description',
  'contactEmail',
  'slug',
]);

const AddPropertyForm: React.FC<AddPropertyFormProps> = ({ userId, onSuccess }) => {
  const [step, setStep] = useState<FormStep>('owner');
  const [form, setForm] = useState<FormState>(initialFormState);
const [images, setImages] = useState<{ name: string; type: string; base64: string }[]>([]);
  const [imagePreviews, setImagePreviews] = useState<string[]>([]);
  const [submitting, setSubmitting] = useState(false);
  const [toast, setToast] = useState<{ message: string; color: string } | null>(null);

  const [countriesList, setCountriesList] = useState<LookupItem[]>([]);
  const [states, setStates] = useState<LookupItem[]>([]);
  const [cities, setCities] = useState<LookupItem[]>([]);
  const [areas, setAreas] = useState<LookupItem[]>([]);

  useEffect(() => {
    apiGet('/country')
      .then((data) => {
        console.log('Country data:', data);
        setCountriesList(data || []);
      })
      .catch((err) => console.error('Country fetch error:', err));
  }, []);

  const updateField = <K extends keyof FormState>(key: K, value: FormState[K]) =>
    setForm((prev) => ({ ...prev, [key]: value }));

  const onCountryChange = async (countryId: string) => {
    const selected = countriesList.find((c) => c.id.toString() === countryId);
    setForm((prev) => ({
      ...prev,
      countryId,
      country: selected?.name || '',
      stateId: '', state: '', cityId: '', city: '', areaId: '', area: '',
    }));
    setCities([]);
    setAreas([]);
    if (!countryId) { setStates([]); return; }
    try {
      const data = await apiGet(`/states?countryId=${countryId}`);
      setStates(data || []);
    } catch (err) {
      console.error('Failed to fetch states', err);
      setStates([]);
    }
  };
  const onStateChange = async (stateId: string) => {
    const selected = states.find((s) => s.id.toString() === stateId);
    setForm((prev) => ({
      ...prev,
      stateId,
      state: selected?.name || '',
      cityId: '', city: '', areaId: '', area: '',
    }));
    setAreas([]);
    if (!stateId) { setCities([]); return; }
    try {
      const data = await apiGet(`/cities?stateId=${stateId}`);
      setCities(data || []);
    } catch (err) {
      console.error('Failed to fetch cities', err);
      setCities([]);
    }
  };

  const onCityChange = async (cityId: string) => {
    const selected = cities.find((c) => c.id.toString() === cityId);
    const cityName = selected?.name || '';
    setForm((prev) => ({
      ...prev,
      cityId,
      city: cityName,
      slug: cityName ? generateSlug(cityName) : prev.slug,
      areaId: '', area: '',
    }));
    if (!cityId) { setAreas([]); return; }
    try {
      const data = await apiGet(`/area?cityId=${cityId}`);
      console.log('Area API response:', data);
      const list = Array.isArray(data) ? data : data.data || [];
      const mapped: LookupItem[] = list.map((a: any) => ({
        id: a.id,
        name: a.name || a.area_name || a.title || '',
      }));
      setAreas(mapped);
    } catch (err) {
      console.error('Failed to fetch areas', err);
      setAreas([]);
    }
  };

  const onAreaChange = (areaId: string) => {
    const selected = areas.find((a) => a.id.toString() === areaId);
    setForm((prev) => ({
      ...prev,
      areaId,
      area: selected?.name || '',
    }));
  };

const handleImageUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
  const files = Array.from(e.target.files || []);
  const valid = files.filter(
    (f) =>
      ['image/jpeg', 'image/png', 'image/jpg', 'image/webp'].includes(f.type) &&
      f.size <= 10 * 1024 * 1024
  );
  if (valid.length !== files.length)
    setToast({ message: 'Only JPG/PNG/WebP under 10 MB allowed.', color: 'warning' });

  for (const file of valid) {
    try {
      const dataUrl = await new Promise<string>((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(r.result as string);
        r.onerror = () => reject(new Error('Failed to read file'));
        r.readAsDataURL(file);
      });
      setImages((p) => [...p, { name: file.name, type: file.type, base64: dataUrl }]);
      setImagePreviews((p) => [...p, dataUrl]);
    } catch (err) {
      console.error('Image read error:', err);
    }
  }

  // Allow re-selecting the same file later
  e.target.value = '';
};

  const removeImage = (i: number) => {
    setImages((p) => p.filter((_, idx) => idx !== i));
    setImagePreviews((p) => p.filter((_, idx) => idx !== i));
  };

  const validateStep = (s: FormStep): string | null => {
    if (s === 'owner') {
      if (!form.contactName.trim()) return 'Name is required';
      if (!form.contactNumber.trim()) return 'Contact number is required';
    }
    if (s === 'basic') {
      if (!form.propertyLocation.trim()) return 'Property location is required';
      if (!form.title.trim()) return 'Title is required';
      if (!form.propertyFor.trim()) return 'Property for is required';
    }
    if (s === 'size') {
      if (!form.squareFt.trim()) return 'Square footage is required';
      if (!form.price.trim()) return 'Price is required';
    }
    return null;
  };

  const currentIdx = STEP_ORDER.indexOf(step);

  const goNext = () => {
    const err = validateStep(step);
    if (err) { setToast({ message: err, color: 'danger' }); return; }
    if (currentIdx < STEP_ORDER.length - 1) setStep(STEP_ORDER[currentIdx + 1]);
  };

  const goBack = () => {
    if (currentIdx > 0) setStep(STEP_ORDER[currentIdx - 1]);
  };

 const handleSubmit = async () => {
  const userId = localStorage.getItem("userId");
  const payload = new FormData();

  // Step validation
  for (const s of STEP_ORDER) {
    const err = validateStep(s);
    if (err) {
      setStep(s);
      setToast({ message: err, color: "danger" });
      return;
    }
  }

  if (!userId) {
    setToast({
      message: "User ID not found. Please log in again.",
      color: "danger",
    });
    return;
  }

  setSubmitting(true);

  try {
    // ── Build the FormData payload ──────────────────────────
    payload.append("userId", userId);

    const skipFields = new Set([...SKIP_CAPITALIZE]);

    Object.entries(form).forEach(([key, value]) => {
      if (value === undefined || value === null) return;
      const shouldCapitalize = typeof value === "string" && !skipFields.has(key);
      const finalValue = shouldCapitalize ? capitalizeWords(value) : value;
      payload.append(key, finalValue.toString());
    });

    if (!form.slug) {
      const slugBase = form.city || form.title || "property";
      payload.set("slug", generateSlug(slugBase));
    }

   payload.append(
  "imagesPayload",
  JSON.stringify(
    images.map((img) => ({
      name: img.name,
      type: img.type,
      data: img.base64.split(',')[1], // "data:image/...;base64," prefix hata diya
    }))
  )
);

    console.log("Submitting Property...");

    const data = await apiPostFormData("/mobileproperty", payload);

    console.log("API Response:", data);

    setToast({
      message: data.message || "Property added successfully!",
      color: "success",
    });

    setForm(initialFormState);
    setImages([]);
    setImagePreviews([]);
    setStates([]);
    setCities([]);
    setAreas([]);
    setStep("owner");

    onSuccess?.();

  } catch (err: any) {
    console.error("Submit Error:", err);
    setToast({
      message: err?.message || "Something went wrong",
      color: "danger",
    });
  } finally {
    setSubmitting(false);
  }
};


  return (
    <div className="apf-root">
      <div className="apf-stepper">
        {STEP_ORDER.map((s, i) => {
          const done = i < currentIdx;
          const active = s === step;
          const isLocked = i > currentIdx; // 🔒 future steps locked until you Continue through validation

          return (
            <React.Fragment key={s}>
              <button
                className={`apf-step-dot ${active ? 'apf-step-dot--active' : ''} ${done ? 'apf-step-dot--done' : ''} ${isLocked ? 'apf-step-dot--locked' : ''}`}
                onClick={() => {
                  if (isLocked) return; // ignore clicks on future/locked tabs
                  setStep(s); // allow jumping back to any already-visited step
                }}
                disabled={isLocked}
                aria-disabled={isLocked}
                aria-label={STEP_LABELS[s]}
              >
                {done ? <IonIcon icon={checkmarkCircle} /> : <span>{i + 1}</span>}
                <span className="apf-step-label">{STEP_LABELS[s]}</span>
              </button>
              {i < STEP_ORDER.length - 1 && (
                <div className={`apf-step-line ${done ? 'apf-step-line--done' : ''}`} />
              )}
            </React.Fragment>
          );
        })}
      </div>

      <div className="apf-card">
        {step === 'owner' && <OwnerInfoStep form={form} updateField={updateField} />}
        {step === 'basic' && <BasicInfoStep form={form} updateField={updateField} />}
        {step === 'size' && <SizePricingStep form={form} updateField={updateField} />}
        {step === 'location' && (
          <LocationStep
            form={form}
            countriesList={countriesList}
            states={states}
            cities={cities}
            areas={areas}
            onCountryChange={onCountryChange}
            onStateChange={onStateChange}
            onCityChange={onCityChange}
            onAreaChange={onAreaChange}
            updateField={updateField}
          />
        )}
        {step === 'bank' && (
          <BankImagesStep
            form={form}
            updateField={updateField}
            imagePreviews={imagePreviews}
            onImageUpload={handleImageUpload}
            onRemoveImage={removeImage}
          />
        )}
      </div>

      <div className="apf-nav">
        <button className="apf-nav-btn apf-nav-btn--back" disabled={step === 'owner'} onClick={goBack}>
          Back
        </button>
        {step !== 'bank' ? (
          <button className="apf-nav-btn apf-nav-btn--next" onClick={goNext}>
            Continue
          </button>
        ) : (
          <button className="apf-nav-btn apf-nav-btn--submit" onClick={handleSubmit} disabled={submitting}>
            {submitting ? <IonSpinner name="dots" /> : 'Save Property'}
          </button>
        )}
      </div>

      <IonToast
        isOpen={!!toast}
        message={toast?.message}
        duration={3000}
        color={toast?.color}
        onDidDismiss={() => setToast(null)}
      />
    </div>
  );
};

// ── Shared field wrapper ──────────────────────────────────
